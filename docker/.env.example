# ==============================================================================
# ENVIRONMENT VARIABLES EXAMPLE - CẤU HÌNH 100% OFFLINE
# Đề tài Thạc sĩ: Hệ thống Tìm kiếm và Hỏi đáp Tài liệu Nội bộ
# ==============================================================================
# Copy file này thành .env và điền các giá trị thực tế
#
# LƯU Ý: Hệ thống này chạy 100% OFFLINE
# - KHÔNG cần OpenAI API key
# - Sử dụng Ollama để chạy LLM local
# - Tất cả models được download và chạy trên máy local
# ==============================================================================

# ==============================================================================
# DATABASE CONFIGURATION - PostgreSQL
# ==============================================================================
POSTGRES_USER=aibfuser
POSTGRES_PASSWORD=aibfpass123_change_in_production
POSTGRES_DB=aibaseframework

# ==============================================================================
# REDIS CONFIGURATION - Cache & Session
# ==============================================================================
REDIS_PASSWORD=redis123_change_in_production

# ==============================================================================
# MINIO CONFIGURATION - Object Storage
# ==============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_in_production
MINIO_BUCKETS=documents,uploads,embeddings

# ==============================================================================
# ===== OLLAMA CONFIGURATION - LLM LOCAL (THAY THẾ OpenAI) =====
# Hệ thống sử dụng Ollama để chạy LLM và Embedding models local
# KHÔNG cần kết nối Internet sau khi download models
# ==============================================================================

# Ollama Chat Model - Model cho chatbot
# Options:
#   llama3.2:3b    : 3B params, 2GB VRAM, fast (recommended)
#   llama3.2:1b    : 1B params, 1GB VRAM, very fast
#   mistral:7b     : 7B params, 5GB VRAM, better quality
#   phi3:latest    : 3.8B params, 2.5GB VRAM, fast
#   qwen2.5:7b     : 7B params, 5GB VRAM, good Vietnamese support
OLLAMA_CHAT_MODEL=llama3.2:3b

# Ollama Embedding Model - Model để tạo vector embeddings
# Options:
#   nomic-embed-text   : 768 dimensions, fast (recommended)
#   mxbai-embed-large : 1024 dimensions, high quality
#   bge-m3:latest     : 1024 dimensions, best quality
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Ollama Performance Settings
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=2000

# GPU Configuration
# Set CUDA_VISIBLE_DEVICES="" để chạy CPU-only mode (không có GPU)
# Set CUDA_VISIBLE_DEVICES="0" để sử dụng GPU đầu tiên
CUDA_VISIBLE_DEVICES=0

# ==============================================================================
# OPENAI API - KHÔNG SỬ DỤNG (Offline Mode)
# Để trống hoặc comment out để sử dụng Ollama thay thế
# Nếu muốn dùng OpenAI, bỏ comment và điền API key
# ==============================================================================
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini

# ==============================================================================
# JWT AUTHENTICATION - Token Configuration
# ==============================================================================
# Tạo secret key bằng: openssl rand -base64 32
JWT_SECRET=your-256-bit-secret-key-change-in-production-minimum-32-chars
JWT_ISSUER=AIBaseFrameworkAPI
JWT_AUDIENCE=AIBaseFrameworkClient
JWT_EXPIRY_MINUTES=60

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
APP_ENVIRONMENT=Development
DOMAIN_NAME=localhost
MAX_UPLOAD_SIZE_MB=50

# ==============================================================================
# RATE LIMITING
# ==============================================================================
RATE_LIMIT_PERMITS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
LOG_LEVEL=Information
SEQ_URL=http://seq:5341

# ==============================================================================
# SSL CERTIFICATES (Production only)
# ==============================================================================
# Placeholder paths - cần được thay thế bằng đường dẫn thực
# SSL_CERT_PATH=/etc/nginx/ssl/certificate.crt
# SSL_KEY_PATH=/etc/nginx/ssl/private.key
