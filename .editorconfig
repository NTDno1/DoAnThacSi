# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{cs,fs}]
indent_size = 4

[*.py]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{csproj,fsproj,sln,props,targets}]
indent_size = 2

[Makefile]
indent_style = tab

[*.bat]
end_of_line = crlf
