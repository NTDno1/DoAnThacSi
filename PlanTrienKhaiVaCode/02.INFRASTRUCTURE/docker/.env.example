# Environment Variables - Development Template
# AI Base Framework - 100% Offline Local Integration

# ============================================
# DATABASE - PostgreSQL
# ============================================
POSTGRES_USER=hlvuser
POSTGRES_PASSWORD=hlvpass123_change_in_production
POSTGRES_DB=aibaseframework

# ============================================
# REDIS - Cache & Session
# ============================================
REDIS_PASSWORD=redis123_change_in_production

# ============================================
# MINIO - Object Storage
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123_change_in_production
MINIO_BUCKET=documents
MINIO_BUCKETS=documents,uploads,embeddings

# ============================================
# OLLAMA - Local LLM (THAY THẾ OPENAI)
# ============================================

# Chat Model (LLM cho chatbot)
# Gợi ý:
# - llama3.2:1b  (~2GB VRAM) - Nhanh, cơ bản
# - llama3.2:3b  (~4GB VRAM) - Cân bằng (khuyến nghị)
# - mistral:7b    (~8GB VRAM) - Chất lượng cao hơn
# - phi3:latest   (~4GB VRAM) - Nhanh, tốt cho CPU
# - qwen2.5:7b  (~8GB VRAM) - Tốt cho Tiếng Việt
OLLAMA_CHAT_MODEL=llama3.2:3b

# Embedding Model (cho semantic search)
# Gợi ý:
# - nomic-embed-text (~274MB) - Nhanh, 768 dimensions (khuyến nghị)
# - mxbai-embed-large (~670MB) - Chất lượng cao hơn, 1024 dimensions
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Ollama Configuration
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=2000

# GPU Configuration
# Để trống hoặc "0" cho CPU-only mode
# Đặt "0" nếu có 1 GPU
# Đặt "0,1" nếu có 2 GPUs
CUDA_VISIBLE_DEVICES=0

# ============================================
# JWT - Authentication
# ============================================
JWT_SECRET=your-256-bit-secret-key-change-in-production-minimum-32-characters-here
JWT_ISSUER=AIBaseFrameworkAPI
JWT_AUDIENCE=AIBaseFrameworkClient
JWT_EXPIRY_MINUTES=60

# ============================================
# SEQ - Log Aggregation
# ============================================
SEQ_PASSWORD=admin123_change_in_production

# ============================================
# APPLICATION - General
# ============================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# ============================================
# OPENAI - KHÔNG SỬ DỤNG (Offline Mode)
# ============================================
# Các biến dưới đây KHÔNG cần thiết vì chúng ta dùng Ollama 100% offline
# Giữ lại đây để tham khảo nếu sau này muốn chuyển sang OpenAI
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini

# ============================================
# PRODUCTION NOTES
# ============================================
# Khi triển khai production, hãy:
# 1. Thay đổi tất cả passwords (POSTGRES_PASSWORD, REDIS_PASSWORD, etc.)
# 2. Tạo JWT_SECRET dài và ngẫu nhiên (ít nhất 32 ký tự)
# 3. Cấu hình SSL certificates
# 4. Cập nhật MINIO_BUCKET nếu cần
# 5. Đặt ASPNETCORE_ENVIRONMENT=Production
