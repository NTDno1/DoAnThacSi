<mxfile host="app.diagrams.net" modified="2026-08-02T09:55:00.000Z" agent="Cursor" version="24.0.0" type="device">
  <diagram id="clean-architecture" name="06 - Clean Architecture trong phân hệ AI">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="title" value="CẤU TRÚC 4 LỚP CLEAN ARCHITECTURE BÊN TRONG MỖI PHÂN HỆ AI&#10;(Ví dụ: AI Gateway)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#0F2A50;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1574" height="60" as="geometry" />
        </mxCell>

        <!-- ========== OUTERMOST: API ========== -->
        <mxCell id="api_layer" value="LỚP 1 — API (Giao tiếp)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="120" width="1100" height="120" as="geometry" />
        </mxCell>
        <mxCell id="api_content" value="• AiGateway.Api&#10;• REST API endpoint, gRPC service&#10;• JWT middleware xác thực&#10;• Controllers, Request/Response DTO&#10;&#10;→ Tiếp nhận yêu cầu HTTP/gRPC từ client" style="text;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="160" width="1020" height="80" as="geometry" />
        </mxCell>

        <!-- ========== INFRASTRUCTURE ========== -->
        <mxCell id="infra_layer" value="LỚP 2 — INFRASTRUCTURE (Hạ tầng)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="270" width="1100" height="120" as="geometry" />
        </mxCell>
        <mxCell id="infra_content" value="• AiGateway.Infrastructure&#10;• Redis client (cache, rate-limit)&#10;• PostgreSQL client (audit log)&#10;• OpenAI/Anthropic API client&#10;• HTTP client cho KMS service&#10;&#10;→ Kết nối với thế giới bên ngoài" style="text;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="310" width="1020" height="80" as="geometry" />
        </mxCell>

        <!-- ========== APPLICATION ========== -->
        <mxCell id="app_layer" value="LỚP 3 — APPLICATION (Xử lý)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="420" width="1100" height="120" as="geometry" />
        </mxCell>
        <mxCell id="app_content" value="• AiGateway.Application&#10;• ProcessRequestHandler (MediatR Command)&#10;• Pipeline behaviors: validate → logging → inject-check&#10;• Use cases: AskQuestion, SummarizeDoc, ClassifyText&#10;&#10;→ Quy trình xử lý yêu cầu" style="text;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="460" width="1020" height="80" as="geometry" />
        </mxCell>

        <!-- ========== DOMAIN (CORE) - INNERMOST ========== -->
        <mxCell id="domain_layer" value="LỚP 4 — DOMAIN (Lõi nghiệp vụ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="570" width="1100" height="180" as="geometry" />
        </mxCell>
        <mxCell id="domain_content" value="• AiGateway.Domain&#10;• Entities: AiRequest, RateLimitCounter, SemanticCacheEntry, AuditLog&#10;• Value Objects: TokenCount, ProviderId, TenantId&#10;• Domain Services: PromptSanitizer, PiiRedactor, ProviderSelector&#10;• Domain Events: AiRequestCompletedEvent, RateLimitExceededEvent&#10;&#10;→ QUY TẮC NGHIỆP VỤ CỐT LÕI (không phụ thuộc framework)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="610" width="1020" height="140" as="geometry" />
        </mxCell>

        <!-- ========== ARROWS (dependency inward) ========== -->
        <mxCell id="arr1" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;strokeWidth=2;endArrow=block;endFill=0;" edge="1" parent="1" source="api_layer" target="infra_layer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr2" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;strokeWidth=2;endArrow=block;endFill=0;" edge="1" parent="1" source="infra_layer" target="app_layer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr3" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;strokeWidth=2;endArrow=block;endFill=0;" edge="1" parent="1" source="app_layer" target="domain_layer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr1_lbl" value="gọi" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;" vertex="1" connectable="0" parent="arr1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="20" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arr2_lbl" value="gọi" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;" vertex="1" connectable="0" parent="arr2">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="20" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arr3_lbl" value="gọi" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;" vertex="1" connectable="0" parent="arr3">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="20" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- ========== ANNOTATIONS ========== -->
        <mxCell id="note_outer" value="LỚP NGOÀI" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note_outer_b" value="(phụ thuộc framework&#10;có thể thay đổi)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="note_inner" value="LỚP TRONG" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note_inner_b" value="(KHÔNG phụ thuộc framework&#10;thay đổi không ảnh hưởng)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- ========== PRINCIPLE BOX ========== -->
        <mxCell id="principle" value="NGUYÊN TẮC DEPENDENCY INVERSION:&#10;Các lớp ngoài phụ thuộc vào lớp trong (qua interface), KHÔNG phụ thuộc ngược lại.&#10;→ Lớp DOMAIN không biết gì về Redis, PostgreSQL, hay OpenAI." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F2A50;strokeColor=#0F2A50;fontColor=white;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="800" width="1480" height="100" as="geometry" />
        </mxCell>

        <!-- ========== LỢI ÍCH ========== -->
        <mxCell id="benefits" value="LỢI ÍCH CỦA CLEAN ARCHITECTURE:&#10;• Dễ thay đổi hạ tầng (đổi Redis → Memcached chỉ cần sửa lớp Infrastructure)&#10;• Dễ test nghiệp vụ (lớp Domain không cần database để chạy test)&#10;• Tăng tốc phát triển (các lớp phát triển song song)&#10;• Giảm rủi ro khi nâng cấp (chỉ thay đổi lớp cần thiết)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="920" width="1480" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
