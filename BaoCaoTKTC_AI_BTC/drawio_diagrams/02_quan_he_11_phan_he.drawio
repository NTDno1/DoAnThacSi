        <!-- Legend -->
        <mxCell id="legend" value="CHÚ THÍCH:&#10;• Cam (đậm) = Phân hệ bảo vệ (Gateway, Auth, Audit, Admin) — quản trị/an ninh&#10;• Xanh lá = Xử lý nghiệp vụ AI (Engine, Agent, Knowledge, OCR) — trực tiếp tạo giá trị&#10;• Xanh dương = Provider (kết nối LLM) — nền tảng&#10;• Cam (nhạt) = MCP, Job Queue — bổ trợ&#10;• Xám = Lớp nền tảng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
