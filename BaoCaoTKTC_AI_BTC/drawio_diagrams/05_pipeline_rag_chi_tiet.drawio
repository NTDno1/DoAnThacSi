        <!-- ========== LEGEND ========== -->
        <mxCell id="legend" value="GIẢI THÍCH CÁC THÀNH PHẦN:&#10;• BGE-M3 = Mô hình embedding đa ngôn ngữ (1024-1536 chiều) — chạy trên GPU nội bộ&#10;• BM25 = Thuật toán tìm theo từ khóa truyền thống, bổ trợ cho tìm ngữ nghĩa&#10;• RRF (Reciprocal Rank Fusion) = Cách hợp nhất 2 danh sách từ 2 phương pháp tìm kiếm&#10;• BGE-reranker-v2-m3 = Mô hình xếp hạng lại, đánh giá độ liên quan chính xác hơn vector similarity&#10;• Faifthfulness = Đánh giá xem câu trả lời có trung thực với văn bản gốc không (chống hallucination)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="780" width="2200" height="180" as="geometry" />
        </mxCell>
