  <diagram id="pipeline-rag" name="05 - Pipeline RAG chi tiết">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2339" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="title" value="PIPELINE RAG (Truy xuất tăng cường) — CHI TIẾT 5 BƯỚC" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0F2A50;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2259" height="40" as="geometry" />
        </mxCell>

        <!-- ========== STEP 1: EMBED ========== -->
        <mxCell id="step1_box" value="BƯỚC 1&#10;EMBED&#10;(Vector hóa)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="280" height="240" as="geometry" />
        </mxCell>
        <mxCell id="embed_input" value="INPUT:&#10;Câu hỏi của user&#10;&#10;(tiếng Việt, 1-3 câu)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="embed_proc" value="Xử lý:&#10;• Encode câu hỏi&#10;• BGE-M3 / OpenAI Embedding&#10;• Output: vector 1536 chiều" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="embed_output" value="OUTPUT:&#10;Dãy số 1536 chiều&#10;(vector đặc trưng của câu hỏi)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="360" height="80" as="geometry" />
        </mxCell>

        <!-- ========== STEP 2: HYBRID SEARCH ========== -->
        <mxCell id="step2_box" value="BƯỚC 2&#10;HYBRID SEARCH&#10;(Tìm kiếm lai)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="490" y="100" width="320" height="240" as="geometry" />
        </mxCell>
        <mxCell id="hs_bm25" value="BM25&#10;(Tìm theo TỪ KHÓA)&#10;→ Top 50 văn bản có từ khóa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="510" y="380" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="hs_cos" value="COSINE SIMILARITY&#10;(Tìm theo NGỮ NGHĨA)&#10;→ Top 50 văn bản có ý nghĩa tương tự" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="510" y="480" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="hs_rrf" value="RRF (Reciprocal Rank Fusion)&#10;Hợp nhất 2 danh sách → 50 ứng viên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="600" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- ========== STEP 3: RERANK ========== -->
        <mxCell id="step3_box" value="BƯỚC 3&#10;RERANK&#10;(Xếp hạng lại)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="900" y="100" width="320" height="240" as="geometry" />
        </mxCell>
        <mxCell id="rerank_model" value="Mô hình: BGE-reranker-v2-m3&#10;(multilingual)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="920" y="380" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rerank_proc" value="Đánh giá lại độ liên quan giữa&#10;câu hỏi và từng đoạn văn bản&#10;→ Chọn Top 8 văn bản tốt nhất" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="920" y="460" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rerank_out" value="OUTPUT: Top 8 văn bản&#10;(được chấm điểm lại)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="600" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- ========== STEP 4: LLM ========== -->
        <mxCell id="step4_box" value="BƯỚC 4&#10;LLM&#10;(Gọi mô hình AI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;fontSize=16;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1320" y="100" width="320" height="240" as="geometry" />
        </mxCell>
        <mxCell id="llm_prompt" value="Prompt đầy đủ:&#10;[System prompt] + [Top 8 văn bản] + [Câu hỏi]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b46504;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1340" y="380" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="llm_choice" value="Chọn mô hình:&#10;• Văn bản mật → Ollama (qwen2.5:14b)&#10;• Văn bản thường → OpenAI (gpt-4o-mini)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b46504;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1340" y="480" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="llm_resp" value="Streaming response" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1340" y="600" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- ========== STEP 5: CITE + QUALITY ========== -->
        <mxCell id="step5_box" value="BƯỚC 5&#10;CITE + QUALITY&#10;(Trích dẫn + Đánh giá)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1730" y="100" width="540" height="240" as="geometry" />
        </mxCell>
        <mxCell id="cite_proc" value="Trích dẫn:&#10;Xác định câu trả lời dựa trên văn bản nào (file, trang, khoảng)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1750" y="380" width="500" height="80" as="geometry" />
        </mxCell>
        <mxCell id="qa_proc" value="Đánh giá chất lượng (Faithfulness):&#10;Câu trả lời có trung thực với văn bản gốc không?&#10;(chống AI 'bịa' thông tin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1750" y="480" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="qa_final" value="OUTPUT CUỐI:&#10;• Câu trả lời (đã stream)&#10;• Trích dẫn nguồn (3-5 văn bản)&#10;• Điểm tin cậy (0.0 - 1.0)&#10;• Thông tin token đã dùng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1750" y="600" width="500" height="100" as="geometry" />
