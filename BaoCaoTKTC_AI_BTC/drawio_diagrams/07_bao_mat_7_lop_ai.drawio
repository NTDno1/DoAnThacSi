        <mxCell id="special_ai" value="DAC BIET CHO AI:
• Chong prompt injection
• Che giau PII
• Rate limit
• HITL cho Agent
• Audit chi tiet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1" vertex="1" parent="1">
